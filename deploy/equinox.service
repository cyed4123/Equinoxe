[Unit]
Description=Equinox web proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=equinox
WorkingDirectory=/opt/equinox
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0
ExecStart=/usr/bin/node /opt/equinox/server.js
Restart=always
RestartSec=3

# Hardening: the proxy needs no write access outside its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
